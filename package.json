{
  "name": "@gina/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "check": "npx ultracite check",
    "check-type": "turbo run check-type",
    "clean": "bunx turbo@latest run clean  && rm -rf dist .turbo",
    "prepare": "husky",
    "generate-types": "bunx openapi-typescript apps/b2badmin/src/types/temp-schema.json  -o ./apps/b2badmin/src/types/api-schema.d.ts",
    "fix": "npx ultracite fix",
    "docker:compose": "docker compose up -d",
    "gen:ai-docs": "bun run  scripts/gen-ai-docs.ts",
    "gen:final": "bun run packages/contract/scripts/gen-all-final.ts",
    "postgen:final": "bun run fix"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/pg": "^8.20.0",
    "husky": "^9.1.7",
    "lefthook": "^2.1.4",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "ultracite": "7.4.0",
    "typescript": "^6.0.2",
    "turbo": "^2.8.21"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.11",
      "elysia": "1.4.28",
      "@biomejs/biome": "2.4.9",
      "better-auth": "^1.5.6",
      "drizzle-orm": "^1.0.0-beta.9-e89174b",
      "@types/pg": "^8.16.0",
      "drizzle-kit": "^1.0.0-beta.9-e89174b",
      "drizzle-typebox": "^1.0.0-beta.9-e89174b",
      "tsx": "^4.21.0",
      "logixlysia": "^6.3.0",
      "typescript": "^6.0.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix",
      "bun x ultracite fix"
    ]
  }
}