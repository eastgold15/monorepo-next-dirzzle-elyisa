{
  "name": "@gina/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "check": "npx ultracite check",
    "fix": "npx ultracite fix",
    "check-type": "turbo run check-type",
    "clean": "bunx turbo@latest run clean  && rm -rf dist .turbo",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/pg": "^8.16.0",
    "husky": "^9.1.7",
    "lefthook": "^2.0.11",
    "lint-staged": "^16.2.7",
    "ultracite": "6.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@sinclair/typebox": "^0.34.41",
    "turbo": "^2.6.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.4",
      "elysia": "1.4.18",
      "typescript": "^5.9.3",
      "@biomejs/biome": "2.3.8",
      "better-auth": "^1.3.34",
      "drizzle-orm": "^0.44.7",
      "@types/pg": "^8.16.0",
      "drizzle-kit": "^0.31.6",
      "drizzle-typebox": "^0.3.3",
      "tsx": "^4.20.6",
      "logixlysia": "^5.3.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix",
      "bun x ultracite fix"
    ]
  }
}