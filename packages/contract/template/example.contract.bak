import { t } from "elysia";
// ✅ 关键：从 Generated 导入 Base (零件) 和 Generated (默认实现)
import { SkusBase, SkusContract as Generated } from "../_generated/skus.contract";
import { ProductsContract } from "../_generated/products.contract";

export const SkusContract = {
  ...Generated, // 1. 继承所有默认 CRUD 定义
  
  // 2. 覆盖 Response：使用 Base.fields 快速重组，并加入 Product 关联
  Response: t.Object({
    ...SkusBase.fields, 
    product: t.Optional(ProductsContract.Response) 
  }),

  // 3. 添加新业务
  BatchCreate: t.Object({
    productId: t.String(),
    skus: t.Array(t.Object({
        ...t.Omit(t.Object(SkusBase.insertFields), ['productId']).properties
    }))
  })
} as const;