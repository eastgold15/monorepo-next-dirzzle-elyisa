{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "rootDir": "./src",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "strictNullChecks": true,
    "esModuleInterop": false
  },
  "include": [
    "src/**/*"
, "template/example.contract.ts"  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}